<?xml version="1.0" encoding="utf-8"?>
<!--
  res/drawable/overlay_bg.xml
  Rounded semi-transparent dark card background for both overlay windows.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent dark navy -->
    <solid android:color="#CC12121F" />

    <!-- Rounded corners -->
    <corners android:radius="14dp" />

    <!-- Subtle border so overlay is visible on any background -->
    <stroke
        android:width="1dp"
        android:color="#44FFFFFF" />

</shape>
