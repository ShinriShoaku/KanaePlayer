<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlay"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="@string/btn_player"
            app:icon="@android:drawable/ic_media_play"
            app:backgroundTint="@color/teal"
            app:cornerRadius="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQueueOverlay"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="@string/btn_queue"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:backgroundTint="@color/purple"
            app:cornerRadius="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLyricsOverlay"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="6dp"
        android:text="@string/btn_lyrics"
        app:icon="@android:drawable/ic_menu_edit"
        app:backgroundTint="@color/lyrics_default"
        app:cornerRadius="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
