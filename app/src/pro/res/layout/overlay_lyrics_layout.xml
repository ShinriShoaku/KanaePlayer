<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_lyrics_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg"
    android:elevation="18dp"
    android:clipToOutline="true">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/overlay_lyrics_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/overlay_header"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <!-- Drag grip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⠿"
            android:textColor="#888888"
            android:textSize="16sp"
            android:layout_marginEnd="6dp" />

        <!-- Icon + Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎤 Lyrics"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- Language badge (e.g. "EN" / "ID" / "AUTO") -->
        <TextView
            android:id="@+id/overlay_lyrics_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@color/purple"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="6dp" />

        <!-- Close -->
        <ImageButton
            android:id="@+id/overlay_lyrics_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close lyrics" />

    </LinearLayout>

    <!-- ── LYRICS BODY ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:minHeight="80dp"
        android:gravity="center">

        <!-- Previous cue (dimmed) -->
        <TextView
            android:id="@+id/overlay_lyrics_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp" />

        <!-- Current active cue (bright, larger) -->
        <TextView
            android:id="@+id/overlay_lyrics_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="— No lyrics available —"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp" />

        <!-- Next cue (dimmed) -->
        <TextView
            android:id="@+id/overlay_lyrics_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- ── LOADING / STATUS ROW ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/overlay_lyrics_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/overlay_lyrics_spinner"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/orange"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/overlay_lyrics_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fetching lyrics…"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- ── TIME ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/overlay_lyrics_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#888888"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
