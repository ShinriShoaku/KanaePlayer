<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#222222"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/overlay_thumbnail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:background="#000000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="1" />

            <ProgressBar
                android:id="@+id/overlay_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:progressTint="#00FF00"
                android:progressBackgroundTint="#222222" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/overlay_btn_play_pause"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_play"
            android:background="#444444"
            app:tint="#00FF00"
            android:layout_margin="1dp" />

        <ImageButton
            android:id="@+id/overlay_btn_skip"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_next"
            android:background="#444444"
            app:tint="#00FF00"
            android:layout_margin="1dp" />

        <ImageButton
            android:id="@+id/overlay_btn_close"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="#444444"
            app:tint="#FF0000"
            android:layout_margin="1dp" />
    </LinearLayout>
</LinearLayout>
