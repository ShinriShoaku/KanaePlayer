<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#E61A1A2E"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#66FFFFFF" />

    <TextView
        android:id="@+id/adj_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjust Widget"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Widget Name"
        app:hintTextColor="@color/orange"
        app:boxStrokeColor="@color/orange"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_adj_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="URL / Source"
        app:hintTextColor="@color/orange"
        app:boxStrokeColor="@color/orange"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_adj_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView android:id="@+id/tv_width_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Width: 400dp" android:textColor="#CCCCCC" android:textSize="12sp" />
            <SeekBar android:id="@+id/seek_width" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="800" />

            <TextView android:id="@+id/tv_height_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Height: 300dp" android:textColor="#CCCCCC" android:textSize="12sp" />
            <SeekBar android:id="@+id/seek_height" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="800" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView android:id="@+id/tv_scale_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Scale: 1.0x" android:textColor="#CCCCCC" android:textSize="12sp" />
            <SeekBar android:id="@+id/seek_scale" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" />

            <TextView android:id="@+id/tv_alpha_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="BG Opacity: 100%" android:textColor="#CCCCCC" android:textSize="12sp" />
            <SeekBar android:id="@+id/seek_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="0" />

            <CheckBox
                android:id="@+id/cb_visual_punch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Visual Punch (Experimental)"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:buttonTint="@color/orange" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Background Color:"
        android:textColor="#CCCCCC"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/color_presets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Colors will be added programmatically or defined here -->
            <View android:id="@+id/color_none" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@android:color/transparent" android:padding="2dp" />
            <View android:id="@+id/color_black" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="#000000" />
            <View android:id="@+id/color_teal" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="#008080" />
            <View android:id="@+id/color_blue" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="#1A1A2E" />
            <View android:id="@+id/color_green" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="#00FF00" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btn_close_adjuster"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF4444"
        android:padding="0dp"
        android:text="Done"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
