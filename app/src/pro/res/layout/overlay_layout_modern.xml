<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="@android:color/transparent">

    <!-- Circle Thumbnail -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:cardCornerRadius="35dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="2dp"
        app:strokeColor="#282727"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/overlay_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minWidth="160dp">

        <!-- Info Box (Title & Sender) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_player_modern_info"
            android:padding="8dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul lagu"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/overlay_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nama pengirim"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Progress Box -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_modern_progress">

            <ProgressBar
                android:id="@+id/overlay_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/orange"
                android:progressBackgroundTint="#44FFFFFF" />
        </FrameLayout>

        <!-- Hidden/Extra fields to satisfy OverlayManager logic -->
        <TextView android:id="@+id/overlay_queue_count" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/overlay_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <View android:id="@+id/overlay_live_dot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <ImageButton android:id="@+id/overlay_btn_play_pause" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <ImageButton android:id="@+id/overlay_btn_skip" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <ImageButton android:id="@+id/overlay_btn_close" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <View android:id="@+id/overlay_expanded_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
