<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Judul section ala Pivot Windows Phone: huruf kecil, tipis, abu-abu -->
    <style name="Metro.Label" parent="">
        <item name="android:textColor">@color/metro_text_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Tile datar: kotak, tanpa sudut, tanpa bayangan -->
    <style name="Metro.Tile" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/metro_tile_light</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="iconTint">@color/metro_text</item>
        <item name="android:textColor">@color/metro_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tile besar bergaya Iconic: ikon di atas, label di bawah -->
    <style name="Metro.Tile.Iconic">
        <item name="iconGravity">textTop</item>
        <item name="iconSize">44dp</item>
        <item name="iconPadding">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Metro.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeColor">@color/metro_box_stroke</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/metro_accent</item>
        <item name="android:textColorHint">@color/metro_text_dim</item>
    </style>

    <style name="Metro.Edit" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/metro_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

</resources>
