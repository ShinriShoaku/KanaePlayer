<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="visible">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overlays"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="20dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Row 1: Player, Queue, Lyrics, Canvas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_teal"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnQueueOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_purple"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Queue"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnLyricsOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_lyrics"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelLyrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lyrics"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnCanvas"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_canvas"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelCanvas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canvas"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Row 2: Chat, Notif, Custom -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnChatOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_teal"
                android:src="@android:drawable/stat_notify_chat"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnNotifOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_red"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_notif"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnCustomOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_purple"
                android:src="@android:drawable/ic_menu_today"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browser"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Row 3: Join, Like, Follow, Keyboards -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnJoinOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_yellow"
                android:src="@android:drawable/ic_menu_add"
                app:tint="@color/bg_dark"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelJoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnLikeOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_red"
                android:src="@drawable/ic_heart"
                app:tint="@color/white"
                android:scaleType="center"
                android:padding="12dp" />
            <TextView
                android:id="@+id/tvLabelLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Like/Tap"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnFollowOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_teal"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:id="@+id/tvLabelFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnMapping"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_purple"
                android:src="?attr/actionModeSelectAllDrawable"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keyboards"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Row 4: Quick Custom, Gift Sound -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnGesture"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_teal"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Custom"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerGiftSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/btnGiftSound"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_purple"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/white"
                android:scaleType="center" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gift Sound"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </GridLayout>
</LinearLayout>
