<?xml version="1.0" encoding="utf-8"?>
<!-- Daftar overlay bergaya Windows Phone "all apps": kotak ikon berwarna + nama.
     Semua ID lama dipertahankan. Ketuk = on/off, tahan = pengaturan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="visible">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="overlays"
        android:textColor="@color/metro_text"
        android:textSize="34sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-light"
        android:text="ketuk untuk on/off · tahan untuk pengaturan"
        android:textColor="@color/metro_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_cobalt"
            android:contentDescription="Player"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelPlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Player"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnQueueOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_violet"
            android:contentDescription="Queue"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelQueue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Queue"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLyricsOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_magenta"
            android:contentDescription="Lyrics"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelLyrics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Lyrics"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCanvas"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_teal"
            android:contentDescription="Canvas"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelCanvas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Canvas"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnChatOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_lime"
            android:contentDescription="Chat"
            android:scaleType="center"
            android:src="@android:drawable/stat_notify_chat"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Chat"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnNotifOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_red"
            android:contentDescription="overlay"
            android:scaleType="center"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelNotif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="@string/btn_notif"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCustomOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_steel"
            android:contentDescription="Browser"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_today"
            app:tint="@color/metro_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Browser"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnJoinOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_amber"
            android:contentDescription="Join"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_add"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelJoin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Join"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLikeOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_magenta"
            android:contentDescription="Like/Tap"
            android:scaleType="center"
            android:src="@drawable/ic_heart"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelLike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Like/Tap"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnFollowOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_cobalt"
            android:contentDescription="Follow"
            android:scaleType="center"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelFollow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Follow"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMapping"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_violet"
            android:contentDescription="Keyboards"
            android:scaleType="center"
            android:src="?attr/actionModeSelectAllDrawable"
            app:tint="@color/metro_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Keyboards"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnGesture"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_teal"
            android:contentDescription="Quick Custom"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/metro_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Quick Custom"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVoiceOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_lime"
            android:contentDescription="Voice"
            android:scaleType="center"
            android:src="@android:drawable/presence_audio_online"
            app:tint="@color/metro_text" />

        <TextView
            android:id="@+id/tvLabelVoice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Voice"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/containerGiftSound"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnGiftSound"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/metro_amber"
            android:contentDescription="Gift Sound"
            android:scaleType="center"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/metro_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="Gift Sound"
            android:textColor="@color/metro_text"
            android:textSize="22sp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
