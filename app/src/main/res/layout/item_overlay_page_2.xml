<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaweriaOverlay"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="6dp"
        android:text="@string/btn_saweria"
        app:icon="@android:drawable/btn_star_big_on"
        app:backgroundTint="@color/yellow"
        android:textColor="@color/bg_dark"
        app:cornerRadius="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCanvas"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="6dp"
        android:text="@string/btn_canvas"
        app:icon="@android:drawable/ic_menu_gallery"
        app:backgroundTint="@color/canvas_default"
        app:cornerRadius="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
