<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_queue_layout.xml
  Wrap-content: height grows automatically as songs are added.
  Header: drag handle | title | count badge | close
  Body:   empty-state text  OR  RecyclerView (max 8 items shown)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_queue_root"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg"
    android:elevation="16dp"
    android:clipToOutline="true">

    <!-- ── HEADER / DRAG HANDLE ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/overlay_queue_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/overlay_header"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <!-- Drag grip icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⠿"
            android:textColor="#888888"
            android:textSize="16sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎶 Antrian"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- Song count badge -->
        <TextView
            android:id="@+id/overlay_queue_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@color/orange"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/overlay_queue_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#AAAAAA"
            android:contentDescription="Close queue" />

    </LinearLayout>

    <!-- ── EMPTY STATE ───────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/overlay_queue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Antrian kosong 🎵"
        android:textColor="#777777"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="14dp"
        android:visibility="visible" />

    <!-- ── QUEUE LIST (wrap_content → auto-expands) ───────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/overlay_rv_queue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

</LinearLayout>
