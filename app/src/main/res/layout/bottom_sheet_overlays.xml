<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:paddingBottom="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/header_pill" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MAIN GRID -->
            <LinearLayout
                android:id="@+id/panelGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overlays"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnOverlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_teal"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="@color/white"
                            android:scaleType="center" />
                        <TextView
                            android:id="@+id/tvLabelPlayer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Player"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnQueueOverlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_purple"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="@color/white"
                            android:scaleType="center" />
                        <TextView
                            android:id="@+id/tvLabelQueue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Queue"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnLyricsOverlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_lyrics"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="@color/white"
                            android:scaleType="center" />
                        <TextView
                            android:id="@+id/tvLabelLyrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lyrics"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnCanvas"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_canvas"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/white"
                            android:scaleType="center" />
                        <TextView
                            android:id="@+id/tvLabelCanvas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Canvas"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnSaweriaOverlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_yellow"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="@color/bg_dark"
                            android:scaleType="center" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saweria"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnChatOverlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_teal"
                            android:src="@android:drawable/stat_notify_chat"
                            app:tint="@color/white"
                            android:scaleType="center" />
                        <TextView
                            android:id="@+id/tvLabelChat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- SETTINGS PANEL (Dynamically shown) -->
            <LinearLayout
                android:id="@+id/panelSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/tvSettingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overlay Settings"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/btnBackToGrid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="@color/text_secondary" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Position X"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/sbPosX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2000"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Position Y"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
                <SeekBar
                    android:id="@+id/sbPosY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="3000"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scale (%)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
                <SeekBar
                    android:id="@+id/sbScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:min="20"
                    android:max="250"
                    android:progress="100"
                    android:layout_marginVertical="8dp" />

                <!-- EXTRA SETTINGS FOR CHAT -->
                <LinearLayout
                    android:id="@+id/extraChatSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvMaxLinesLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Max Chat Lines: 5"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sbMaxLines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="1"
                        android:max="20"
                        android:progress="5"
                        android:layout_marginVertical="8dp" />

                    <CheckBox
                        android:id="@+id/cbChatTransparent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Transparent Background"
                        android:textColor="@color/text_primary"
                        android:checked="true"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvChatWidthLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chat Overlay Width: 300dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sbChatWidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="100"
                        android:max="1000"
                        android:progress="300"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/tvChatDurationLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chat Display Duration: 6s"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sbChatDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="1"
                        android:max="30"
                        android:progress="6"
                        android:layout_marginVertical="8dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveOverlaySettings"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="SAVE SETTINGS"
                    app:backgroundTint="@color/orange"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold icon to open settings. Use sliders for precise control if gestures are bugged."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingHorizontal="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
