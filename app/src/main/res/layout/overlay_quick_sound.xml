<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Minimized Bubble -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_minimized"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="@color/teal"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="2.5dp"
        app:strokeColor="#66FFFFFF">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/media3_icon_playlist_add"
            app:tint="@color/bg_dark"
            android:contentDescription="Open" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Expanded Soundboard Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="@dimen/quick_overlay_margin"
        app:cardBackgroundColor="#F2121212"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#4D14B8A6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="16dp"
                android:background="#1A000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="QUICK CUSTOM OVERLAY"
                    android:textColor="@color/teal"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

                <ImageButton
                    android:id="@+id/btn_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/red"
                    android:alpha="0.8"
                    android:contentDescription="Close" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sound_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="250dp"
                android:padding="8dp"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Add sounds in settings"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:paddingBottom="16dp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
