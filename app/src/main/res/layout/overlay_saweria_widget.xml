<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating overlay container for Saweria WebView widgets.
  Root is transparent so only the widget content is visible.
  A small close [✕] button sits in the top-right corner.
-->
<ame.project.kanae.overlay.PunchThroughLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/punch_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- WebView fills the whole overlay -->
    <WebView
        android:id="@+id/saweria_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Transparent overlay to catch gestures (drag/scale/rotate) -->
    <View
        android:id="@+id/saweria_gesture_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Close button – top-right, semi-transparent pill -->
    <ImageButton
        android:id="@+id/saweria_btn_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="#CC1A1A2E"
        android:padding="4dp"
        android:contentDescription="Close widget" />

</ame.project.kanae.overlay.PunchThroughLayout>
