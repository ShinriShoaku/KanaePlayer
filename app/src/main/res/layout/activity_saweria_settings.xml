<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🪙 Saweria Overlay"
                android:textSize="22sp"
                android:textColor="#FF9800"
                android:textStyle="bold" />

            <View
                android:id="@+id/saweria_live_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#FF5252"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/saweria_live_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum dikonfigurasi"
                android:textColor="#888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Stream Key card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️  STREAM KEY"
                    android:textColor="#FF9800"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stream Key"
                    android:textColor="#AAAACC"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <EditText
                        android:id="@+id/et_stream_key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="0db856078d4e5dbfa145bb5a1ed850e1"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#444466"
                        android:backgroundTint="#FF9800"
                        android:layout_marginEnd="8dp" />

                    <ImageButton
                        android:id="@+id/btn_toggle_key_visibility"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Lihat stream key" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Dapatkan Stream Key dari saweria.co → Widget → salin nilai ?streamKey=... dari URL"
                    android:textColor="#555577"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <!-- URL preview -->
                <TextView
                    android:id="@+id/tv_url_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="saweria.co/widgets/alert?streamKey=—"
                    android:textColor="#333355"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btn_save_saweria"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="💾  Simpan Stream Key"
                    android:backgroundTint="#FF9800"
                    android:textColor="#000000"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Widget toggles card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🪟  WIDGET OVERLAY"
                    android:textColor="#FF9800"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap untuk tampilkan/sembunyikan · Drag untuk pindah · Pinch untuk resize &amp; rotate"
                    android:textColor="#444466"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp" />

                <!-- Row 1: Alert + Top Up -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <Button android:id="@+id/btn_widget_alert"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🔔 Alert" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/btn_widget_topup"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="💰 Top Up" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Row 2: Media Share + QR Code -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <Button android:id="@+id/btn_widget_mediashare"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🎬 Media Share" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/btn_widget_qr"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="📱 QR Code" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Row 3: Milestone + Leaderboard -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <Button android:id="@+id/btn_widget_milestone"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🎯 Milestone" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/btn_widget_leaderboard"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🏆 Leaderboard" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Row 4: Recent + Wheel -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <Button android:id="@+id/btn_widget_recent"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🕐 Recent" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/btn_widget_wheel"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🎡 Wheel" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Row 5: Subathon + Voting -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <Button android:id="@+id/btn_widget_subathon"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="⏱️ Subathon" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/btn_widget_vote"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:text="🗳️ Voting" android:backgroundTint="#1F1F3A"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Actions card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛠️  AKSI"
                    android:textColor="#FF9800"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_hide_all_saweria"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🙈 Sembunyikan Semua"
                        android:backgroundTint="#2D1B1B"
                        android:textColor="#FF5252"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_reload_all_saweria"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔄 Reload Semua"
                        android:backgroundTint="#1B2D1B"
                        android:textColor="#4CAF50"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️  Overlay berjalan persis seperti OBS Browser Source – animasi, suara &amp; tampilan dikontrol sepenuhnya oleh server Saweria."
                    android:textColor="#333355"
                    android:textSize="11sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>