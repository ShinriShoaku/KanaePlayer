<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_layout.xml
  Compact bar (always visible): live-dot | 🎵 | title (marquee) | play | skip | close
  Tap anywhere on bar (not on buttons) → expand/collapse to show thumbnail + progress + time
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg"
    android:elevation="16dp"
    android:clipToOutline="true">

    <!-- ── COMPACT BAR (always visible) ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/overlay_compact_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:background="@color/overlay_header">

        <!-- Live dot -->
        <View
            android:id="@+id/overlay_live_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_red"
            android:layout_marginEnd="6dp" />

        <!-- Music icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <!-- Title (marquee) -->
        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="– Nothing playing –"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Play/Pause button -->
        <ImageButton
            android:id="@+id/overlay_btn_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_media_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/orange"
            android:contentDescription="Play/Pause" />

        <!-- Skip button -->
        <ImageButton
            android:id="@+id/overlay_btn_skip"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#CCCCCC"
            android:contentDescription="Skip" />

        <!-- Close button -->
        <ImageButton
            android:id="@+id/overlay_btn_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#AAAAAA"
            android:contentDescription="Close"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <!-- ── EXPANDED SECTION (hidden by default, animated on tap) ─────── -->
    <LinearLayout
        android:id="@+id/overlay_expanded_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Thumbnail + Queue count row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Thumbnail card (centered) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/overlay_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Queue badge top-right -->
            <TextView
                android:id="@+id/overlay_queue_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:text="Q: 0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@color/orange"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </FrameLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/overlay_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/orange"
            android:progressBackgroundTint="#333333" />

        <!-- Time display -->
        <TextView
            android:id="@+id/overlay_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

</LinearLayout>
