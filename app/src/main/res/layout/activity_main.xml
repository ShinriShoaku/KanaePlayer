<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — Kanae Player Redesign (Modern Dark)
  High-contrast UI with Material Components.
  All IDs preserved for compatibility with MainActivity.kt
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipToPadding="false">

        <!-- HEADER SECTION -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textSize="26sp"
                    android:textColor="@color/orange"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#40000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvTiktokStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚫ TikTok"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:background="@drawable/status_pill_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvYtdlpStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚫ yt-dlp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:background="@drawable/status_pill_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <ImageButton
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_dialog_email"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/feedback_label"
                    app:tint="@color/orange"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>
        </RelativeLayout>

        <!-- PERMISSION WARNING (Styled as a block) -->
        <TextView
            android:id="@+id/tvOverlayWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_warning_msg"
            android:textColor="@color/yellow"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#22F59E0B"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_permission"
            app:backgroundTint="@color/yellow"
            android:textColor="@color/bg_dark"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- NOW PLAYING CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing_label"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nothing_playing"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="24dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/orange"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="end"
                    android:fontFamily="monospace" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PLAYBACK CONTROLS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <!-- Stop Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:padding="0dp"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconSize="24dp"
                        app:iconTint="@color/red"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:cornerRadius="30dp"
                        app:strokeColor="@color/red"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <!-- Play/Pause Button (Wider to support text + icon) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="140dp"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="16dp"
                        android:text="@string/btn_play"
                        app:backgroundTint="@color/orange"
                        app:cornerRadius="32dp"

                        app:iconSize="24dp"
                        app:iconTint="@color/bg_dark"
                        android:textColor="@color/bg_dark"
                        android:textStyle="bold"
                        app:elevation="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <!-- Skip Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:padding="0dp"
                        app:icon="@android:drawable/ic_media_next"
                        app:iconSize="24dp"
                        app:iconTint="@color/purple"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:cornerRadius="30dp"
                        app:strokeColor="@color/purple"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShuffle"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="🔀 Shuffle OFF"
                    app:backgroundTint="#12121F"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1FFFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- COMMAND PERMISSIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COMMAND PERMISSIONS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminList"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:text="AUTHORIZED USERS (SKIP/STOP/CM)"
            app:icon="@android:drawable/ic_lock_lock"
            app:backgroundTint="@color/card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            app:cornerRadius="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/text_primary" />

        <!-- OVERLAY CONTROLS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_overlays_label"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowOverlays"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:text="OPEN QUICK OVERLAYS"
            app:icon="@android:drawable/ic_menu_manage"
            app:backgroundTint="@color/card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            app:cornerRadius="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/text_primary" />

        <!-- ADD TO QUEUE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_to_queue_label"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/yt_url_hint"
                    app:boxBackgroundColor="#0A0A0F"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:hintTextColor="@color/orange"
                    app:boxStrokeColor="@color/orange"
                    app:boxStrokeWidth="1dp"
                    android:layout_marginBottom="20dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYoutubeUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/text_primary"
                        android:paddingVertical="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddToQueue"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/btn_add"
                        app:backgroundTint="@color/orange"
                        android:textColor="@color/bg_dark"
                        android:layout_marginEnd="10dp"
                        app:cornerRadius="16dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearQueue"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="0.8"
                        android:text="@string/btn_clear_all"
                        android:textColor="@color/red"
                        app:strokeColor="@color/red"
                        app:cornerRadius="16dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- QUEUE LIST -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/up_next_label"
                        android:textColor="@color/orange"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tvQueueCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_songs"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:background="@drawable/status_pill_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQueue"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TIKTOK CHAT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tiktok_chat_label"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <ScrollView
                    android:id="@+id/scrollChat"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#0A0A0F"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvChatLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#BBBBBB"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- EULERSTREAM & TIKTOK CONNECT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EULERSTREAM CONNECT"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- API Key -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/api_key_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- TikTok Username -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/tiktok_user_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTiktokUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectTiktok"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="CONNECT TIKTOK"
                    app:backgroundTint="@color/orange"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PLAYER SETTINGS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            android:layout_marginBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PLAYER CONFIGURATION"
                    android:textColor="@color/orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- Request Limit -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/request_limit_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="28dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRequestLimit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- LYRICS LANG -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lyrics_pref_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="28dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/lyrics_lang_hint"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLyricsLang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLength="5"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangId"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:text="ID"
                        android:padding="0dp"
                        app:cornerRadius="16dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangEn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:text="EN"
                        android:padding="0dp"
                        app:cornerRadius="16dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <!-- COMMANDS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cmd_prefixes_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cmd_req_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdRequest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cmd_skip_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdSkip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cmd_stop_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdStop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cmd_queue_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdQueue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cmd_clear_music_hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="32dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdClearMusic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="SAVE CONFIGURATION"
                    app:backgroundTint="@color/purple"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
