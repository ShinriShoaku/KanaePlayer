<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml - Kanae Player: Windows Phone "Iconic" theme.
  Semua ID lama dipertahankan agar kompatibel dengan MainActivity.kt.
  Layout Start-screen: mosaik tile; tile Add/UpNext/Chat/Connect/Config expand di tempat.
  ID baru: tile*/hdr*/body* (Now Playing, AddQueue, UpNext, Chat, Connect, Config), dll.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metro_black"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="48dp"
        android:clipToPadding="false">
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:text="kanae player"
            android:textColor="@color/metro_text"
            android:textSize="34sp" />
        <TextView
            android:id="@+id/tvOverlayWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/metro_amber"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/overlay_warning_msg"
            android:textColor="@color/metro_black"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantOverlay"
            style="@style/Metro.Tile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="2dp"
            android:text="grant permission"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/tileNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/metro_accent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical">

            <!-- Bagian collapsed: cover (icon lagu) + judul + equalizer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@color/metro_tile_overlay">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="♪"
                        android:textColor="#B3FFFFFF"
                        android:textSize="48sp" />

                    <ImageView
                        android:id="@+id/ivNowPlayingArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-light"
                            android:text="now playing"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <ame.project.kanae.EqualizerView
                            android:id="@+id/eqPlaying"
                            android:layout_width="18dp"
                            android:layout_height="14dp" />

                        <ImageView
                            android:id="@+id/ivChevron"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/metro_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:maxLines="2"
                        android:text="nothing playing"
                        android:textColor="@color/metro_text"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:text="0:00 / 0:00"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#40FFFFFF"
                android:progressTint="@color/metro_text" />

            <!-- Bagian expanded: cover besar + kontrol (muncul saat tile diketuk) -->
            <LinearLayout
                android:id="@+id/nowPlayingExpanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@color/metro_tile_overlay"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="♪"
                        android:textColor="#B3FFFFFF"
                        android:textSize="84sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintEnd_toEndOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintStart_toStartOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintTop_toTopOf="@id/ivNowPlayingArtLarge" />

                    <ImageView
                        android:id="@+id/ivNowPlayingArtLarge"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:layout_constraintDimensionRatio="H,16:10"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:background="@drawable/metro_art_scrim"
                        app:layout_constraintBottom_toBottomOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintEnd_toEndOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintStart_toStartOf="@id/ivNowPlayingArtLarge" />

                    <TextView
                        android:id="@+id/tvNowPlayingMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="10dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:maxLines="1"
                        android:textColor="@color/metro_text"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintEnd_toEndOf="@id/ivNowPlayingArtLarge"
                        app:layout_constraintStart_toStartOf="@id/ivNowPlayingArtLarge" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Metro.Tile"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:contentDescription="stop"
                        android:paddingHorizontal="0dp"
                        app:backgroundTint="@color/metro_tile_overlay"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="28dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayPause"
                        style="@style/Metro.Tile"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="2"
                        android:text="play"
                        android:textSize="20sp"
                        app:backgroundTint="@color/metro_tile_overlay"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconGravity="textStart"
                        app:iconSize="28dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkip"
                        style="@style/Metro.Tile"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:contentDescription="next"
                        android:paddingHorizontal="0dp"
                        app:backgroundTint="@color/metro_tile_overlay"
                        app:icon="@android:drawable/ic_media_next"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="28dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        app:tint="@color/metro_text" />

                    <SeekBar
                        android:id="@+id/sbMusicVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressBackgroundTint="#66FFFFFF"
                        android:progressTint="@color/metro_text"
                        android:splitTrack="false"
                        android:thumbTint="@color/metro_text" />

                    <TextView
                        android:id="@+id/tvMusicVolume"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/metro_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShuffle"
                    style="@style/Metro.Tile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="shuffle off"
                    app:backgroundTint="@color/metro_tile_overlay" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/tileAddQueue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/hdrAddQueue"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@color/metro_teal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_metro_add" />

                    <TextView
                        android:layout_gravity="start|bottom" android:layout_marginStart="12dp" android:layout_marginBottom="10dp" android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="add to queue"
                        android:textColor="@color/metro_text" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/bodyAddQueue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/metro_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Metro.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/yt_url_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etYoutubeUrl"
                            style="@style/Metro.Edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddToQueue"
                            style="@style/Metro.Tile"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1.3"
                            android:text="add to queue"
                            app:backgroundTint="@color/metro_accent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearQueue"
                            style="@style/Metro.Tile"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1"
                            android:text="clear all"
                            app:backgroundTint="@color/metro_red" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tileUpNext"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/hdrUpNext"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@color/metro_cobalt"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_metro_queue" />

                    <TextView
                        android:layout_gravity="start|bottom" android:layout_marginStart="12dp" android:layout_marginBottom="10dp" android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="up next"
                        android:textColor="@color/metro_text" />
                    <TextView
                        android:id="@+id/tvQueueCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/metro_text"
                        android:textSize="40sp" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/bodyUpNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/metro_tile"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:visibility="gone">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvQueue"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:background="@color/metro_tile"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvTiktokStatus"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp" android:layout_marginBottom="3dp"
                        android:background="@color/metro_violet"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="⚫\ntiktok"
                        android:textColor="@color/metro_text"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvYtdlpStatus"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp" android:layout_marginBottom="3dp"
                        android:background="@color/metro_lime"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="⚫\nyt-dlp"
                        android:textColor="@color/metro_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnDevNote"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp" android:layout_marginTop="3dp"
                        android:background="@color/metro_amber"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="📝\ndev note"
                        android:textColor="@color/metro_text"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                    <TextView
                        android:id="@+id/btnFeedback"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp" android:layout_marginTop="3dp"
                        android:background="@color/metro_magenta"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="💬\nfeedback"
                        android:textColor="@color/metro_text"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/btnAdminList"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@color/metro_violet"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_metro_lock" />

                <TextView
                    android:layout_gravity="start|bottom" android:layout_marginStart="12dp" android:layout_marginBottom="10dp" android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="authorized users"
                    android:textColor="@color/metro_text" />
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/btnShowOverlays"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="6dp"
            android:background="@color/metro_magenta"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_metro_layers" />

            <TextView
                android:layout_gravity="start|center_vertical" android:layout_marginStart="72dp" android:textSize="22sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="quick overlays"
                android:textColor="@color/metro_text" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/tileChat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/hdrChat"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@color/metro_lime"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_metro_chat" />

                    <TextView
                        android:layout_gravity="start|bottom" android:layout_marginStart="12dp" android:layout_marginBottom="10dp" android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="tiktok chat"
                        android:textColor="@color/metro_text" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/bodyChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/metro_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">
                    <ScrollView
                        android:id="@+id/scrollChat"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@color/metro_tile_light"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvChatLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#BBBBBB"
                            android:textSize="12sp" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tileConnect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/hdrConnect"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@color/metro_amber"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_metro_link" />

                    <TextView
                        android:layout_gravity="start|bottom" android:layout_marginStart="12dp" android:layout_marginBottom="10dp" android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="eulerstream"
                        android:textColor="@color/metro_text" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/bodyConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/metro_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Metro.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/api_key_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKey"
                            style="@style/Metro.Edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Metro.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/tiktok_user_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTiktokUser"
                            style="@style/Metro.Edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnectTiktok"
                        style="@style/Metro.Tile"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:text="connect tiktok"
                        android:textSize="20sp"
                        app:backgroundTint="@color/metro_accent" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tileConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/hdrConfig"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@color/metro_steel"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_metro_settings" />

                <TextView
                    android:layout_gravity="start|center_vertical" android:layout_marginStart="72dp" android:textSize="22sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="player configuration"
                    android:textColor="@color/metro_text" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/bodyConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/metro_tile"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEnableCommandsLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-light"
                        android:text="enable chat commands"
                        android:textColor="@color/metro_text"
                        android:textSize="16sp" />

                    <SeekBar
                        android:id="@+id/sbEnableCommands"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:max="1"
                        android:progress="1"
                        android:progressTint="@color/metro_accent"
                        android:splitTrack="false"
                        android:thumbTint="@color/metro_accent" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="@string/request_limit_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRequestLimit"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="lyrics preference"
                    style="@style/Metro.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Metro.Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/lyrics_lang_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLyricsLang"
                            style="@style/Metro.Edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangId"
                        style="@style/Metro.Tile"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:padding="0dp"
                        android:text="ID"
                        app:backgroundTint="@color/metro_cobalt" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangEn"
                        style="@style/Metro.Tile"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="4dp"
                        android:padding="0dp"
                        android:text="EN"
                        app:backgroundTint="@color/metro_violet" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="command prefixes"
                    style="@style/Metro.Label" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/cmd_req_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdRequest"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/cmd_skip_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdSkip"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/cmd_stop_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdStop"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/cmd_queue_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdQueue"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/cmd_clear_music_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdClearMusic"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Metro.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="@string/cmd_lyric_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCmdLyric"
                        style="@style/Metro.Edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    style="@style/Metro.Tile"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="save configuration"
                    android:textSize="20sp"
                    app:backgroundTint="@color/metro_cobalt" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
