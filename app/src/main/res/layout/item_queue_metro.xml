<?xml version="1.0" encoding="utf-8"?>
<!-- Item antrian di layar utama (khusus MainActivity). item_queue.xml asli TIDAK diubah
     karena masih dipakai QueueOverlayManager. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="2dp"
    android:background="@color/metro_tile_light"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@color/metro_accent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="♪"
            android:textColor="#B3FFFFFF"
            android:textSize="26sp" />

        <ImageView
            android:id="@+id/iv_song_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:textColor="@color/metro_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tv_song_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:textColor="@color/metro_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_play_now"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="Play now"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/metro_accent" />

    <ImageButton
        android:id="@+id/btn_remove"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="Remove from queue"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/metro_text_dim" />
</LinearLayout>
